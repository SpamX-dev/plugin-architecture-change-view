{
  "name": "plugin-architecture-change-view",
  "version": "0.4.0",
  "description": "ArchiView: structured architecture contracts, snapshot evidence and review visualization",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SpamX-dev/plugin-architecture-change-view.git"
  },
  "homepage": "https://github.com/SpamX-dev/plugin-architecture-change-view#readme",
  "bugs": {
    "url": "https://github.com/SpamX-dev/plugin-architecture-change-view/issues"
  },
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.23.4"
  },
  "bin": {
    "archiview": "dist/cli.mjs"
  },
  "files": [
    "dist/cli.mjs",
    "dist/bridges/",
    "dist/scip/",
    "dist/package.json",
    "dist/LICENSE",
    "dist/docs/",
    "dist/skills/",
    "dist/web/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node --import tsx cli/cli.ts",
    "archiview": "node --import tsx cli/cli.ts",
    "typecheck": "tsc --noEmit",
    "build:web": "node --import tsx builds/build-web.ts",
    "build": "npm run typecheck && node --import tsx builds/build.ts",
    "pretest": "npm run build",
    "test": "node --import tsx --test --test-concurrency=3 test/*.test.ts",
    "pretest:web": "npm run build",
    "test:web": "node --import tsx tools/browser-test.ts",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.17.0",
    "@scip-code/scip": "0.10.0",
    "@sourcegraph/scip-typescript": "0.6.2",
    "diff": "^9.0.0",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "playwright": "^1.65.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
