{
  "name": "plugin-architecture-change-view",
  "version": "0.4.0",
  "description": "ArchiView: structured architecture contracts, snapshot evidence and review visualization",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SpamX-dev/plugin-architecture-change-view.git"
  },
  "homepage": "https://github.com/SpamX-dev/plugin-architecture-change-view#readme",
  "bugs": {
    "url": "https://github.com/SpamX-dev/plugin-architecture-change-view/issues"
  },
  "type": "module",
  "main": "dist/dsh/lib/index.js",
  "exports": {
    ".": "./dist/dsh/lib/index.js",
    "./client": "./dist/dsh/lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "plugin-architecture-change-view": "src/server.mjs",
    "archiview": "src/cli.mjs"
  },
  "files": [
    "dist/dsh",
    "src",
    "skills",
    "web",
    "docs",
    "dist/panel.html",
    "arch.yaml",
    "cordis.patch.yml",
    "plugin.json",
    "mcp.json",
    "README.md"
  ],
  "scripts": {
    "start": "node src/server.mjs",
    "build:plugin": "node scripts/build-plugin.mjs",
    "build:portable": "node scripts/build-portable.mjs",
    "install:codex": "node scripts/install-plugin.mjs",
    "build:dsh": "node scripts/build-dsh.mjs",
    "pretest": "npm run build:plugin",
    "archiview": "node src/archiview/cli.mjs",
    "test": "node --test"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^2.0.4",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "diff": "^9.0.0",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-skill": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-skill": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  }
}
