{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "analyse/**/*.ts",
    "builds/**/*.ts",
    "cli/**/*.ts",
    "framework/**/*.ts",
    "module-operations/**/*.ts",
    "test/**/*.ts",
    "tools/**/*.ts",
    "web/**/*.ts"
  ]
}
